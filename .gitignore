# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
.next
out

# Turbo
.turbo

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage
.nyc_output

# Prisma
prisma/migrations/dev.db

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker
docker-compose.override.yml

# Uploads (local dev only)
uploads/

# Playwright
test-results/
playwright-report/
e2e/artifacts/

# Playwright saved auth session
e2e/.auth/

# TypeScript incremental build cache — a build artefact, regenerated on every
# compile, and it made a diff appear on every branch.
*.tsbuildinfo

# Uploaded documents. In a real deployment these are patient records — they
# must never reach version control. The directory itself is created at runtime.
storage/
apps/api/storage/

# Database backups. These are full copies of the patient database — names,
# phone numbers and every appointment — and are encrypted at rest but must
# never be committed.
backups/
*.dump
*.dump.enc
*.manifest.enc

# Compiled output belongs in each package's dist, which is where tsconfig puts
# it. Copies committed next to the source shadowed the real build: the web app
# resolved a stale packages/config/src/index.js and reported a function that
# existed as not exported.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
