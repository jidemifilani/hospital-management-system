  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum PayComponentType {
  BASIC_SALARY
  HOUSING_ALLOWANCE
  TRANSPORT_ALLOWANCE
  MEDICAL_ALLOWANCE
  OVERTIME
  BONUS
  PENSION_DEDUCTION
  TAX_DEDUCTION
  LOAN_DEDUCTION
  OTHER_ALLOWANCE
  OTHER_DEDUCTION
}

model Payroll {
  id              String        @id @default(cuid())
  payrollNumber   String        @unique
  staffId         String
  organizationId  String
  month           Int
  year            Int
  basicSalary     Decimal       @db.Decimal(12, 2)
  grossPay        Decimal       @db.Decimal(12, 2)
