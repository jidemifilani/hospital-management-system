// ─── Clinical Core: Encounters, Admissions, Charges ───────────────────────────

enum EncounterType {
  OUTPATIENT
  INPATIENT
  EMERGENCY
  DAY_CASE
  TELEMEDICINE
}

enum EncounterStatus {
  PLANNED
  ARRIVED
  TRIAGED
  IN_CONSULTATION
  OBSERVATION
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum AdmissionType {
  ELECTIVE
  EMERGENCY
  MATERNITY
  TRANSFER_IN
  DAY_CASE
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED_OUT
  ABSCONDED
  DECEASED
}

enum ServiceCategory {
  CONSULTATION
  LABORATORY
  RADIOLOGY
  PROCEDURE
  SURGERY
  BED_CHARGE
  NURSING
  PHARMACY
  CONSUMABLE
  AMBULANCE
  OTHER
}

enum ChargeSource {
  MANUAL
  CONSULTATION
  LAB_ORDER
  RADIOLOGY_ORDER
  PHARMACY_DISPENSE
  BED_DAY
  PROCEDURE
  THEATRE
}

/// Universal episode of care. Every clinical event and charge hangs off one of these.
model Encounter {
  id                String          @id @default(cuid())
  encounterNumber   String          @unique
  patientId         String
  type              EncounterType   @default(OUTPATIENT)
  status            EncounterStatus @default(PLANNED)
  appointmentId     String?
  departmentId      String
  attendingDoctorId String?
  chiefComplaint    String?
  startedAt         DateTime        @default(now())
  endedAt           DateTime?
  disposition       String?
  isBillable        Boolean         @default(true)
  organizationId    String
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  patient         Patient      @relation(fields: [patientId], references: [id])
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  department      Department   @relation(fields: [departmentId], references: [id])
  attendingDoctor Staff?       @relation("EncounterAttending", fields: [attendingDoctorId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  admission        Admission?
  charges          Charge[]
  vitalSigns       VitalSigns[]
  clinicalNotes    ClinicalNote[]
  diagnoses        Diagnosis[]
  labOrders        LabOrder[]
  radiologyOrders  RadiologyOrder[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  triageRecords    TriageRecord[]
  opdQueues        OpdQueue[]
  dietOrders       DietOrder[]
  marRecords       MARRecord[]
  wardRounds       WardRound[]
  carePlans        CarePlan[]
  theatreBookings  TheatreBooking[]
  rehabSessions    RehabSession[]
  dischargeRecords DischargeRecord[]

  @@index([patientId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, startedAt])
  @@map("encounters")
}

/// Inpatient stay. One per INPATIENT encounter.
model Admission {
  id                   String          @id @default(cuid())
  admissionNumber      String          @unique
  encounterId          String          @unique
  patientId            String
  admissionType        AdmissionType   @default(EMERGENCY)
  status               AdmissionStatus @default(ACTIVE)
  admittedAt           DateTime        @default(now())
  expectedDischargeAt  DateTime?
  dischargedAt         DateTime?
  admittingDoctorId    String
  attendingDoctorId    String?
  reason               String
  provisionalDiagnosis String?
  lengthOfStayDays     Int?
  lastBedChargeOn      DateTime?
  organizationId       String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  encounter       Encounter    @relation(fields: [encounterId], references: [id])
  patient         Patient      @relation(fields: [patientId], references: [id])
  admittingDoctor Staff        @relation("AdmissionAdmitting", fields: [admittingDoctorId], references: [id])
  attendingDoctor Staff?       @relation("AdmissionAttending", fields: [attendingDoctorId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  bedAssignments   BedAssignment[]
  dischargeRecords DischargeRecord[]

  @@index([patientId])
  @@index([organizationId, status])
  @@index([organizationId, admittedAt])
  @@map("admissions")
}

/// Bed occupancy history — supports ward transfers and per-night bed billing.
model BedAssignment {
  id             String    @id @default(cuid())
  admissionId    String
  bedId          String
  assignedAt     DateTime  @default(now())
  releasedAt     DateTime?
  assignedById   String?
  reason         String?
  organizationId String
  createdAt      DateTime  @default(now())

  admission  Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bed        Bed       @relation(fields: [bedId], references: [id])
  assignedBy Staff?    @relation("BedAssignedBy", fields: [assignedById], references: [id])

  @@index([admissionId])
  @@index([bedId])
  @@index([organizationId, releasedAt])
  @@map("bed_assignments")
}

/// Billable service catalogue — the single source of truth for pricing.
model ServiceItem {
  id             String          @id @default(cuid())
  code           String
  name           String
  category       ServiceCategory
  unitPrice      Decimal         @db.Decimal(12, 2)
  nhisPrice      Decimal?        @db.Decimal(12, 2)
  hmoPrice       Decimal?        @db.Decimal(12, 2)
  unit           String?
  description    String?
  isActive       Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  charges         Charge[]
  labOrderItems   LabOrderItem[]
  radiologyOrders RadiologyOrder[]
  beds            Bed[]
  departments     Department[]

  @@unique([code, organizationId])
  @@index([organizationId, category])
  @@map("service_items")
}

/// Every billable event lands here automatically, then gets rolled into an invoice.
/// The (source, sourceRef) unique index makes charge posting idempotent.
model Charge {
  id             String          @id @default(cuid())
  encounterId    String
  patientId      String
  serviceItemId  String?
  description    String
  category       ServiceCategory
  source         ChargeSource    @default(MANUAL)
  sourceRef      String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  invoiceId      String?
  isBilled       Boolean         @default(false)
  isVoided       Boolean         @default(false)
  voidReason     String?
  incurredAt     DateTime        @default(now())
  createdById    String?
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  encounter    Encounter    @relation(fields: [encounterId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  serviceItem  ServiceItem? @relation(fields: [serviceItemId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  createdBy    Staff?       @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([source, sourceRef])
  @@index([encounterId])
  @@index([patientId])
  @@index([organizationId, isBilled])
  @@map("charges")
}

/// Which tests a lab order actually contains — needed for per-test billing.
model LabOrderItem {
  id            String  @id @default(cuid())
  labOrderId    String
  serviceItemId String?
  testName      String
  testCode      String?

  labOrder    LabOrder     @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  serviceItem ServiceItem? @relation(fields: [serviceItemId], references: [id])

  @@index([labOrderId])
  @@map("lab_order_items")
}

// ─── Accounting: double-entry ledger ──────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Source that produced a journal entry, so postings can be traced back.
enum JournalSource {
  MANUAL
  INVOICE
  PAYMENT
  REFUND
  PURCHASE
  INVENTORY
  PAYROLL
  OPENING_BALANCE
  ADJUSTMENT
}

/// Chart of accounts. Self-referencing so groups can nest.
model Account {
  id             String      @id @default(cuid())
  code           String
  name           String
  type           AccountType
  parentId       String?
  description    String?
  isActive       Boolean     @default(true)
  /// Postings are only allowed on leaf accounts, never on a group.
  isPostable     Boolean     @default(true)
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  lines        JournalLine[]
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@unique([code, organizationId])
  @@index([organizationId, type])
  @@map("accounts")
}

/// A balanced set of debits and credits. Never edited once posted — a mistake
/// is corrected by a reversing entry, so the trail stays intact.
model JournalEntry {
  id             String        @id @default(cuid())
  entryNumber    String        @unique
  entryDate      DateTime      @default(now())
  description    String
  reference      String?
  status         JournalStatus @default(POSTED)
  source         JournalSource @default(MANUAL)
  sourceId       String?
  reversesId     String?       @unique
  postedById     String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines        JournalLine[]
  reverses     JournalEntry?  @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy   JournalEntry?  @relation("Reversal")
  postedBy     Staff?         @relation("JournalPostedBy", fields: [postedById], references: [id])
  organization Organization   @relation(fields: [organizationId], references: [id])

  @@unique([source, sourceId])
  @@index([organizationId, entryDate])
  @@index([organizationId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  description    String?
  /// Who the balance is with, for receivables and payables ageing.
  partnerType    String?
  partnerId      String?
  organizationId String

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([organizationId, partnerType, partnerId])
  @@map("journal_lines")
}

/// Locks a date range once the books are closed.
model FiscalPeriod {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean  @default(false)
  closedAt       DateTime?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
  @@index([organizationId, startDate])
  @@map("fiscal_periods")
}
