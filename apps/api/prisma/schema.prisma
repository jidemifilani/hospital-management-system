// ─────────────────────────────────────────────────────────────────────────────
// CareSync HMS — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum StaffRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DEPARTMENT_HEAD
  DOCTOR
  NURSE
  LAB_TECHNOLOGIST
  RADIOLOGIST
  PHARMACIST
  CASHIER
  RECEPTIONIST
  HR_OFFICER
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  LAB_TEST
  IMAGING
  TELEMEDICINE
  EMERGENCY
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PRINT
}

enum ClinicalNoteType {
  SOAP
  PROGRESS
  DISCHARGE
  REFERRAL
  PROCEDURE
  NURSING
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  DIFFERENTIAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  CHRONIC
  RULED_OUT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  POS_CARD
  BANK_TRANSFER
  NHIS
  HMO
  INSURANCE
  MOBILE_MONEY
}

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  RESULTED
  VERIFIED
  CANCELLED
}

enum LabOrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum PrescriptionStatus {
  PENDING
  DISPENSING
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  ON_CALL
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  address              String?
  phone                String?
  email                String?
  website              String?
  logoUrl              String?
  notificationSettings Json?
  siteContent          Json?
  siteTheme            Json?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users         User[]
  staff         Staff[]
  patients      Patient[]
  encounters    Encounter[]
  admissions    Admission[]
  serviceItems  ServiceItem[]
  charges       Charge[]
  accounts      Account[]
  journalEntries JournalEntry[]
  fiscalPeriods FiscalPeriod[]
  departments   Department[]
  appointments  Appointment[]
  auditLogs     AuditLog[]
  invoices      Invoice[]
  payments      Payment[]
  labOrders     LabOrder[]
  prescriptions Prescription[]
  drugItems     DrugItem[]
  drugStock     DrugStock[]
  rosters       Roster[]
  leaveRequests   LeaveRequest[]
  radiologyOrders RadiologyOrder[]
  referrals       Referral[]
  opdQueues       OpdQueue[]
  attendances     Attendance[]
  incidents       IncidentReport[]
  bloodDonors     BloodDonor[]
  bloodUnits      BloodUnit[]
  bloodRequests   BloodRequest[]
  insuranceClaims InsuranceClaim[]
  mortuaryRecords MortuaryRecord[]
  theatreBookings TheatreBooking[]
  carePlans       CarePlan[]
  purchaseOrders  PurchaseOrder[]
  assets          Asset[]
  dietOrders           DietOrder[]
  triageRecords        TriageRecord[]
  payrolls             Payroll[]
  medicalCertificates  MedicalCertificate[]
  visitors             Visitor[]
  appraisals           StaffAppraisal[]
  patientFeedback      PatientFeedback[]
  ambulances           Ambulance[]
  transports           Transport[]
  marRecords           MARRecord[]
  maintenanceRequests  MaintenanceRequest[]
  trainingRecords      TrainingRecord[]
  patientAlerts        PatientAlert[]
  shiftHandovers       ShiftHandover[]
  rehabSessions        RehabSession[]
  wardRounds           WardRound[]
  consentForms         ConsentForm[]
  dischargeRecords     DischargeRecord[]

  @@map("organizations")
}

// ─── Auth / Users ─────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  role           StaffRole
  status         UserStatus @default(PENDING_VERIFICATION)
  mfaEnabled     Boolean    @default(false)
  mfaSecret      String?
  mfaBackupCodes String[]
  lastLoginAt    DateTime?
  lastLoginIp    String?
  organizationId String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id])
  staff         Staff?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Department {
  id             String   @id @default(cuid())
  name           String
  code           String
  description    String?
  headOfDeptId   String?
  consultationServiceItemId String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  staff        Staff[]
  appointments Appointment[]
  beds         Bed[]
  rosters      Roster[]
  referrals    Referral[]
  opdQueues    OpdQueue[]
  incidents    IncidentReport[]
  assets        Asset[]
  handovers     ShiftHandover[]
  encounters    Encounter[]
  consultationServiceItem ServiceItem? @relation(fields: [consultationServiceItemId], references: [id])

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("departments")
}

model Staff {
  id             String    @id @default(cuid())
  employeeId     String    @unique
  userId         String    @unique
  firstName      String
  lastName       String
  phone          String
  specialization String?
  licenseNumber  String?
  qualifications String[]
  departmentId   String
  isActive       Boolean   @default(true)
  joiningDate    DateTime  @default(now())
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])

  appointments      Appointment[]      @relation("DoctorAppointments")
  clinicalNotes     ClinicalNote[]
  diagnoses         Diagnosis[]
  vitalSigns        VitalSigns[]
  labOrdersRequested LabOrder[]        @relation("LabRequestedBy")
  labOrdersCollected LabOrder[]        @relation("LabCollectedBy")
  labResultsVerified LabResult[]
  prescribedRx      Prescription[]     @relation("PrescribedBy")
  dispensedRx       Prescription[]     @relation("DispensedBy")
  paymentsReceived  Payment[]
  rosters           Roster[]
  leaveRequests            LeaveRequest[]
  leaveApprovals           LeaveRequest[]    @relation("LeaveApprovals")
  radiologyOrdersRequested RadiologyOrder[]  @relation("RadRequested")
  radiologyOrdersPerformed RadiologyOrder[]  @relation("RadPerformed")
  radiologyResults         RadiologyResult[] @relation("RadReported")
  radiologyResultsVerified RadiologyResult[] @relation("RadVerified")
  referralsMade            Referral[]        @relation("ReferralBy")
  referralsReceived        Referral[]        @relation("ReferralTo")
  opdQueues                OpdQueue[]        @relation("QueueDoctor")
  attendances              Attendance[]
  incidentsReported        IncidentReport[]  @relation("IncidentReporter")
  incidentsAssigned        IncidentReport[]  @relation("IncidentAssignee")
  bloodRequests            BloodRequest[]    @relation("BloodRequestedBy")
  mortuaryRecords          MortuaryRecord[]  @relation("MortuaryAdmittedBy")
  surgeriesAsSurgeon       TheatreBooking[]  @relation("SurgeonBookings")
  surgeriesAsAnaesthesiologist TheatreBooking[] @relation("AnaesthesiologistBookings")
  surgeriesAsAssistant     TheatreBooking[]  @relation("AssistantSurgeonBookings")
  carePlansAsNurse         CarePlan[]        @relation("NurseCarePlans")
  purchaseOrdersCreated    PurchaseOrder[]   @relation("POCreatedBy")
  dietOrders               DietOrder[]       @relation("DietOrderedBy")
  triageRecords            TriageRecord[]    @relation("TriageNurse")
  payrolls                 Payroll[]
  certificatesIssued       MedicalCertificate[] @relation("CertIssuedBy")
  approvedVisitors         Visitor[]         @relation("VisitorApprovedBy")
  appraisals               StaffAppraisal[]  @relation("AppraisalStaff")
  appraisalsGiven          StaffAppraisal[]  @relation("AppraisalReviewer")
  feedbackResponded        PatientFeedback[] @relation("FeedbackResponder")
  marAdministered          MARRecord[]       @relation("MARAdministeredBy")
  maintenanceRequested     MaintenanceRequest[] @relation("MaintenanceRequestedBy")
  maintenanceAssigned      MaintenanceRequest[] @relation("MaintenanceAssignedTo")
  trainingRecords          TrainingRecord[]
  alertsCreated            PatientAlert[]    @relation("AlertCreatedBy")
  alertsResolved           PatientAlert[]    @relation("AlertResolvedBy")
  handoversFrom            ShiftHandover[]   @relation("HandoverFrom")
  handoversTo              ShiftHandover[]   @relation("HandoverTo")
  rehabSessions            RehabSession[]    @relation("RehabTherapist")
  wardRoundsAsDoctor       WardRound[]       @relation("WardRoundDoctor")
  wardRoundsAsNurse        WardRound[]       @relation("WardRoundNurse")
  consentsRequested        ConsentForm[]     @relation("ConsentRequestedBy")
  dischargesProcessed      DischargeRecord[] @relation("DischargeDoctor")
  encountersAttending      Encounter[]       @relation("EncounterAttending")
  admissionsAdmitting      Admission[]       @relation("AdmissionAdmitting")
  admissionsAttending      Admission[]       @relation("AdmissionAttending")
  bedAssignmentsMade       BedAssignment[]   @relation("BedAssignedBy")
  chargesCreated           Charge[]          @relation("ChargeCreatedBy")
  journalEntriesPosted     JournalEntry[]    @relation("JournalPostedBy")

  @@index([departmentId])
  @@index([organizationId])
  @@map("staff")
}

// ─── Patients ─────────────────────────────────────────────────────────────────

model Patient {
  id                       String      @id @default(cuid())
  mrn                      String      @unique
  firstName                String
  lastName                 String
  dateOfBirth              DateTime
  gender                   Gender
  phone                    String
  email                    String?
  address                  String?
  state                    String?
  country                  String      @default("Nigeria")
  bloodGroup               BloodGroup?
  allergies                String?
  ninNumber                String?
  nhisNumber               String?
  hmoProvider              String?
  hmoNumber                String?
  photoUrl                 String?
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String
  isActive                 Boolean     @default(true)
  organizationId           String
  createdById              String?
  updatedById              String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  deletedAt                DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id])
  appointments  Appointment[]
  consents      Consent[]
  vitalSigns    VitalSigns[]
  clinicalNotes ClinicalNote[]
  diagnoses     Diagnosis[]
  invoices        Invoice[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]
  radiologyOrders  RadiologyOrder[]
  referrals        Referral[]
  opdQueues        OpdQueue[]
  incidents        IncidentReport[]
  bloodRequests    BloodRequest[]
  insuranceClaims  InsuranceClaim[]
  mortuaryRecords  MortuaryRecord[]
  theatreBookings  TheatreBooking[]
  carePlans        CarePlan[]
  dietOrders           DietOrder[]
  triageRecords        TriageRecord[]
  medicalCertificates  MedicalCertificate[]
  visitors             Visitor[]
  feedback             PatientFeedback[]
  transports           Transport[]
  marRecords           MARRecord[]       @relation("PatientMAR")
  alerts               PatientAlert[]    @relation("PatientAlerts")
  rehabSessions        RehabSession[]    @relation("PatientRehab")
  wardRounds           WardRound[]       @relation("PatientWardRounds")
  consentForms         ConsentForm[]     @relation("PatientConsents")
  dischargeRecords     DischargeRecord[] @relation("PatientDischarges")
  encounters           Encounter[]
  admissions           Admission[]
  charges              Charge[]

  @@index([mrn])
  @@index([phone])
  @@index([organizationId])
  @@index([lastName, firstName])
  @@map("patients")
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  departmentId    String
  scheduledAt     DateTime
  durationMinutes Int               @default(30)
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  chiefComplaint  String?
  notes           String?
  cancelReason    String?
  isTelemedicine  Boolean           @default(false)
  meetingUrl      String?
  reminderSentAt  DateTime?
  organizationId  String
  createdById     String?
  updatedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  patient      Patient      @relation(fields: [patientId], references: [id])
  doctor       Staff        @relation("DoctorAppointments", fields: [doctorId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  vitalSigns   VitalSigns[]
  clinicalNotes ClinicalNote[]
  diagnoses    Diagnosis[]
  labOrders       LabOrder[]
  invoices        Invoice[]
  prescriptions   Prescription[]
  radiologyOrders RadiologyOrder[]
  referrals       Referral[]
  encounters      Encounter[]

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@map("appointments")
}

// ─── Beds ─────────────────────────────────────────────────────────────────────

model Bed {
  id           String    @id @default(cuid())
  bedNumber    String
  ward         String
  wardClass    String?
  serviceItemId String?
  departmentId String
  isOccupied   Boolean   @default(false)
  patientId    String?
  admittedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department  Department     @relation(fields: [departmentId], references: [id])
  serviceItem ServiceItem?   @relation(fields: [serviceItemId], references: [id])
  assignments BedAssignment[]

  @@unique([bedNumber, departmentId])
  @@index([departmentId])
  @@map("beds")
}

// ─── Consent / NDPR ───────────────────────────────────────────────────────────

model Consent {
  id          String    @id @default(cuid())
  patientId   String
  type        String
  description String
  granted     Boolean
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  ipAddress   String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("consents")
}

// ─── EMR: Vital Signs ─────────────────────────────────────────────────────────

model VitalSigns {
  id               String   @id @default(cuid())
  patientId        String
  appointmentId    String?
  encounterId      String?
  recordedById     String
  temperature      Float?
  systolicBP       Int?
  diastolicBP      Int?
  heartRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  weight           Float?
  height           Float?
  bmi              Float?
  bloodGlucose     Float?
  pain             Int?
  notes            String?
  recordedAt       DateTime @default(now())
  organizationId   String
  createdAt        DateTime @default(now())

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  encounter   Encounter?   @relation(fields: [encounterId], references: [id])
  recordedBy  Staff        @relation(fields: [recordedById], references: [id])

  @@index([patientId])
  @@index([appointmentId])
  @@map("vital_signs")
}

// ─── EMR: Clinical Notes (SOAP) ───────────────────────────────────────────────

model ClinicalNote {
  id             String           @id @default(cuid())
  patientId      String
  appointmentId  String?
  encounterId    String?
  authorId       String
  noteType       ClinicalNoteType @default(SOAP)
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  content        String?
  isDraft        Boolean          @default(false)
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  encounter   Encounter?   @relation(fields: [encounterId], references: [id])
  author      Staff        @relation(fields: [authorId], references: [id])

  @@index([patientId])
  @@index([appointmentId])
  @@index([authorId])
  @@map("clinical_notes")
}

// ─── EMR: Diagnoses ───────────────────────────────────────────────────────────

model Diagnosis {
  id             String          @id @default(cuid())
  patientId      String
  appointmentId  String?
  encounterId    String?
  diagnosedById  String
  icdCode        String?
  description    String
  diagnosisType  DiagnosisType   @default(PRIMARY)
  status         DiagnosisStatus @default(ACTIVE)
  diagnosedAt    DateTime        @default(now())
  resolvedAt     DateTime?
  notes          String?
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient      Patient      @relation(fields: [patientId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  diagnosedBy  Staff        @relation(fields: [diagnosedById], references: [id])

  @@index([patientId])
  @@index([appointmentId])
  @@map("diagnoses")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  patientId      String
  appointmentId  String?
  encounterId    String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  notes          String?
  createdById    String
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  patient         Patient          @relation(fields: [patientId], references: [id])
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id])
  encounter       Encounter?       @relation(fields: [encounterId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  items           InvoiceItem[]
  charges         Charge[]
  payments        Payment[]
  insuranceClaims InsuranceClaim[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  category    String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  reference      String?
  receivedById   String
  notes          String?
  organizationId String
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  receivedBy   Staff        @relation(fields: [receivedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([invoiceId])
  @@index([organizationId])
  @@map("payments")
}

// ─── Laboratory ───────────────────────────────────────────────────────────────

model LabOrder {
  id             String           @id @default(cuid())
  orderNumber    String           @unique
  patientId      String
  appointmentId  String?
  encounterId    String?
  requestedById  String
  priority       LabOrderPriority @default(ROUTINE)
  status         LabOrderStatus   @default(PENDING)
  clinicalInfo   String?
  sampleType     String?
  collectedAt    DateTime?
  collectedById  String?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  patient      Patient      @relation(fields: [patientId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  requestedBy  Staff        @relation("LabRequestedBy", fields: [requestedById], references: [id])
  collectedBy  Staff?       @relation("LabCollectedBy", fields: [collectedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  results      LabResult[]
  items        LabOrderItem[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@map("lab_orders")
}

model LabResult {
  id           String    @id @default(cuid())
  labOrderId   String
  testName     String
  testCode     String?
  result       String
  unit         String?
  normalRange  String?
  isAbnormal   Boolean   @default(false)
  isCritical   Boolean   @default(false)
  verifiedById String?
  notes        String?
  resultedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())

  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  verifiedBy Staff?   @relation(fields: [verifiedById], references: [id])

  @@unique([labOrderId, testName])
  @@index([labOrderId])
  @@map("lab_results")
}

// ─── Pharmacy & Inventory ─────────────────────────────────────────────────────

model DrugItem {
  id             String   @id @default(cuid())
  name           String
  genericName    String?
  code           String
  category       String
  unit           String
  reorderLevel   Int      @default(50)
  sellingPrice   Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stock        DrugStock[]
  prescItems   PrescriptionItem[]
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([code, organizationId])
  @@index([organizationId])
  @@map("drug_items")
}

model DrugStock {
  id             String   @id @default(cuid())
  drugItemId     String
  batchNumber    String
  quantity       Int
  expiresAt      DateTime
  supplierName   String?
  costPerUnit    Decimal  @db.Decimal(10, 2)
  receivedAt     DateTime @default(now())
  organizationId String
  createdAt      DateTime @default(now())

  drugItem     DrugItem     @relation(fields: [drugItemId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([drugItemId])
  @@index([organizationId])
  @@map("drug_stock")
}

model Prescription {
  id               String             @id @default(cuid())
  prescriptionNo   String             @unique
  patientId        String
  prescribedById   String
  appointmentId    String?
  encounterId      String?
  status           PrescriptionStatus @default(PENDING)
  notes            String?
  dispensedById    String?
  dispensedAt      DateTime?
  organizationId   String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  patient      Patient            @relation(fields: [patientId], references: [id])
  prescribedBy Staff              @relation("PrescribedBy", fields: [prescribedById], references: [id])
  dispensedBy  Staff?             @relation("DispensedBy", fields: [dispensedById], references: [id])
  appointment  Appointment?       @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?         @relation(fields: [encounterId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  items        PrescriptionItem[]

  @@index([patientId])
  @@index([organizationId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
