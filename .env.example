# ─────────────────────────────────────────────────────────────
# ROOT — shared across all apps. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://hms_user:hms_password@localhost:5432/hms_db?schema=public"
DATABASE_URL_TEST="postgresql://hms_user:hms_password@localhost:5432/hms_test?schema=public"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NOT READ. Refresh tokens are not JWTs: they are opaque random strings
# stored in the refresh_tokens table with an expiry and a revocation flag,
# which is why no secret is needed to verify one. Kept only so the name does
# not look mysteriously absent.
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
# NOT READ. The seven-day life is set in code where the row is written.
JWT_REFRESH_EXPIRES_IN="7d"

# ── API ───────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"   # /api/v1 is appended automatically by api-client
NEXT_PUBLIC_APP_NAME="CareSync HMS"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ── File storage ──────────────────────────────────────────────
# Uploaded documents are written to local disk. Keep this OUTSIDE anything the
# web server serves: files are streamed through an authenticated endpoint so
# every download is permission-checked and audited, and a publicly served
# directory would bypass both.
FILE_STORAGE_ROOT="./storage/documents"

# ── AWS S3 ────────────────────────────────────────────────────
# NOT IMPLEMENTED. Nothing reads these. They are kept as the shape an S3
# driver would take behind StorageService; setting them has no effect today.
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_S3_BUCKET="hms-dev-files"
AWS_S3_ENDPOINT=""           # Leave empty for real AWS; set for localstack

# ── Email ─────────────────────────────────────────────────────
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@caresync.ng"

# ── SMS — Termii ──────────────────────────────────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="CareSync"

# ── Encryption (PHI field-level) ──────────────────────────────
# REQUIRED. The API refuses to start without it. A key that is merely absent
# would otherwise mean patient records quietly written in plain text, which is
# the failure you would not notice.
#
# Generate with:  openssl rand -hex 32
#
# What it covers, in the database: NIN, NHIS and HMO numbers, home address,
# allergies, next of kin, and the free text of every clinical note. AES-256-GCM
# with a fresh IV per value, so equal values do not produce equal ciphertexts.
#
# What it does NOT cover: names, MRN, phone and email. Patient search matches
# on those columns and ciphertext cannot be searched, so encrypting them would
# leave the search box returning nothing at all. They are protected by volume
# encryption and access control instead.
#
# Losing this key loses the data it covers. Keep a copy somewhere other than
# the database backup, or a restore brings back rows that nothing can read.
#
# Full picture, including the volume encryption this does not replace:
# docs/encryption-at-rest.md
FIELD_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ── Backups ───────────────────────────────────────────────────
# A separate key from FIELD_ENCRYPTION_KEY, on purpose: whoever restores a
# backup does not have to be given the key to the live patient columns, and
# rotating one does not force rotating the other.
#
# Generate with:  openssl rand -hex 32
#
# The dump is encrypted before it reaches disk. Column encryption is not
# enough on its own — a dump still holds every name, MRN, phone number and
# appointment in the clear.
#
# Store this key somewhere other than the backups. A backup and its key in the
# same place is one theft, and a key lost with the database it protects makes
# every copy unreadable.
BACKUP_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# Where backups are written, and how long they are kept. The newest is never
# deleted, whatever the retention, so a misconfigured 0 cannot leave you with
# nothing.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# Only for machines with no postgres client tools installed — runs pg_dump,
# pg_restore and psql inside this container instead. Leave empty on a server
# or CI runner, which have the binaries.
PG_DOCKER_CONTAINER=""

# ── Audit retention ───────────────────────────────────────────
# The audit trail is partitioned by month so the seven-year retention can be
# enforced by dropping whole months, which is instant, instead of deleting rows
# out of one enormous table, which is not.
#
# Seven years is the period this data is held under. The API refuses to drop
# anything when this is set lower, because a mistyped number here would destroy
# records the hospital is required to keep. If a shorter period is genuinely
# correct for your jurisdiction, set AUDIT_RETENTION_BELOW_STATUTORY to
# "yes-i-have-checked-the-law" as well.
AUDIT_RETENTION_YEARS=7

# How many months of partitions to keep ahead of today. The API does this at
# startup and on the first of each month; the margin is what covers a month
# boundary passing while nothing happened to be running.
AUDIT_PARTITION_MONTHS_AHEAD=3

# ── App ───────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"

# Sign-in rate limit, applied per account (not per IP, because every staff
# login reaches the API from the web server's single address). Defaults to 10
# attempts per 15 minutes when unset. Raise it for local runs where an
# automated suite signs in repeatedly as one account.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=900000
