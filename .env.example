# ─────────────────────────────────────────────────────────────
# ROOT — shared across all apps. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://hms_user:hms_password@localhost:5432/hms_db?schema=public"

# Where migrations connect. The same address as DATABASE_URL on a single
# server; on a managed Postgres that offers a pooled endpoint (Neon, Supabase,
# RDS Proxy) this must be the DIRECT one. The pooled endpoint runs pgbouncer
# in transaction mode, which keeps no session state, and `prisma migrate`
# needs both an advisory lock and prepared statements -- pointed at the pooler
# it hangs or fails part-way through a deploy.
DIRECT_URL="postgresql://hms_user:hms_password@localhost:5432/hms_db?schema=public"
DATABASE_URL_TEST="postgresql://hms_user:hms_password@localhost:5432/hms_test?schema=public"

# ── Redis ─────────────────────────────────────────────────────
# Used for the job queues and for rate-limit counters.
#
# The counters belong here rather than in each process's memory. In memory they
# reset on every restart — so each deploy handed out a fresh ten login attempts
# — and they were kept per process, so two instances meant twenty attempts and
# three meant thirty, none of which is visible from LOGIN_RATE_LIMIT below.
#
# If Redis becomes unreachable the API does not stop: it logs an error and falls
# back to counting in memory, which is the weaker per-instance behaviour rather
# than no limit at all. That log line is worth alerting on — while it is
# appearing, the login limit is per instance and will reset on restart.
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NOT READ. Refresh tokens are not JWTs: they are opaque random strings
# stored in the refresh_tokens table with an expiry and a revocation flag,
# which is why no secret is needed to verify one. Kept only so the name does
# not look mysteriously absent.
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
# NOT READ. The seven-day life is set in code where the row is written.
JWT_REFRESH_EXPIRES_IN="7d"

# ── API ───────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# Where the browser reaches the web app. The API builds the links it hands to
# other people out of this: the address Paystack returns a patient to after
# paying, and the links inside scheduled report emails. Left at the default on
# a real deployment, a patient who has just paid is sent to localhost.
WEB_URL="http://localhost:3000"

# ── Frontend ──────────────────────────────────────────────────
# NEXT_PUBLIC_* is compiled into the browser bundle by `next build`, not read
# when the server starts. It has to be set for the build — docker-compose
# passes it as a build arg — because setting it only at runtime leaves every
# browser pointing at whatever was compiled in, which is this default.
NEXT_PUBLIC_API_URL="http://localhost:4000"   # /api/v1 is appended automatically by api-client
NEXT_PUBLIC_APP_NAME="CareSync HMS"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Session cookies for the staff console. NEXTAUTH_URL is the browser-facing
# address of the web app; next-auth reads it itself and signs cookies against
# it, so a mismatch logs people straight back out.
#
# Generate the secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ── File storage ──────────────────────────────────────────────
# Where uploaded documents go: "local" for disk, "s3" for a bucket.
#
# Local disk is right for a deployment that owns its server and mounts a
# volume over the directory. It is wrong for a managed host — Render, Railway,
# Fly — where the container filesystem is replaced on every deploy: documents
# written there are patient records that disappear the next time the service
# ships, with the database rows left pointing at nothing.
#
# "s3" with any setting missing refuses to start rather than quietly writing
# to a disk that will be wiped.
STORAGE_DRIVER="local"

# Only read when STORAGE_DRIVER=local. Keep this OUTSIDE anything the web
# server serves: files are streamed through an authenticated endpoint so every
# download is permission-checked and audited, and a publicly served directory
# would bypass both.
FILE_STORAGE_ROOT="./storage/documents"

# ── S3 storage ────────────────────────────────────────────────
# Only read when STORAGE_DRIVER=s3. Works with anything that speaks S3:
# AWS, Cloudflare R2, Backblaze B2, MinIO. Addressing is path-style, so a
# bucket name containing a dot is fine.
#
# The bucket must be private. Downloads are streamed back through the API so
# each one is permission-checked and audited; a public bucket hands out
# patient documents to anyone holding a URL.
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
# Leave empty for AWS itself. For R2:
#   https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT=""

# ── Email ─────────────────────────────────────────────────────
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@caresync.ng"

# ── Payments — Paystack ───────────────────────────────────────
# The live secret key, not the public one. Invoice payment links, the card
# terminal flow and the online pharmacy all initialise transactions with it,
# and the webhook signature is verified against it.
#
# Empty is not an error anywhere: every payment simply fails to initialise, so
# an unset key looks like a broken checkout rather than a missing setting.
PAYSTACK_SECRET_KEY=""

# ── SMS — Termii ──────────────────────────────────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="CareSync"

# ── Encryption (PHI field-level) ──────────────────────────────
# REQUIRED. The API refuses to start without it. A key that is merely absent
# would otherwise mean patient records quietly written in plain text, which is
# the failure you would not notice.
#
# Generate with:  openssl rand -hex 32
#
# What it covers, in the database: NIN, NHIS and HMO numbers, home address,
# allergies, next of kin, and the free text of every clinical note. AES-256-GCM
# with a fresh IV per value, so equal values do not produce equal ciphertexts.
#
# What it does NOT cover: names, MRN, phone and email. Patient search matches
# on those columns and ciphertext cannot be searched, so encrypting them would
# leave the search box returning nothing at all. They are protected by volume
# encryption and access control instead.
#
# Losing this key loses the data it covers. Keep a copy somewhere other than
# the database backup, or a restore brings back rows that nothing can read.
#
# Full picture, including the volume encryption this does not replace:
# docs/encryption-at-rest.md
FIELD_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ── Backups ───────────────────────────────────────────────────
# A separate key from FIELD_ENCRYPTION_KEY, on purpose: whoever restores a
# backup does not have to be given the key to the live patient columns, and
# rotating one does not force rotating the other.
#
# Generate with:  openssl rand -hex 32
#
# The dump is encrypted before it reaches disk. Column encryption is not
# enough on its own — a dump still holds every name, MRN, phone number and
# appointment in the clear.
#
# Store this key somewhere other than the backups. A backup and its key in the
# same place is one theft, and a key lost with the database it protects makes
# every copy unreadable.
BACKUP_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# Where backups are written, and how long they are kept. The newest is never
# deleted, whatever the retention, so a misconfigured 0 cannot leave you with
# nothing.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# Hour of the day the backup sidecar runs, 0-23, local time. The wait is
# measured against the clock, so restarting the stack does not drag the backup
# around the day.
BACKUP_HOUR=2

# Only for machines with no postgres client tools installed — runs pg_dump,
# pg_restore and psql inside this container instead. Leave empty on a server
# or CI runner, which have the binaries.
PG_DOCKER_CONTAINER=""

# Where finished backups are copied to, off the machine that made them.
#
# A backup sitting on the same host as the database is half a backup. On a
# managed host it is none: a scheduled job's filesystem is discarded when the
# job ends, so a dump written there lives for about a second. Set the bucket
# and both the encrypted dump and its manifest are copied out before the job
# exits. Leave empty on a single server that keeps them on a volume.
#
# Credentials come from the AWS_* block above. Retention of the remote copies
# belongs to a bucket lifecycle rule rather than to this script: deleting old
# backups is precisely the permission a compromised backup job should not
# have.
BACKUP_S3_BUCKET=""
BACKUP_S3_PREFIX="caresync"
BACKUP_S3_ENDPOINT=""

# ── Audit retention ───────────────────────────────────────────
# The audit trail is partitioned by month so the seven-year retention can be
# enforced by dropping whole months, which is instant, instead of deleting rows
# out of one enormous table, which is not.
#
# Seven years is the period this data is held under. The API refuses to drop
# anything when this is set lower, because a mistyped number here would destroy
# records the hospital is required to keep. If a shorter period is genuinely
# correct for your jurisdiction, set AUDIT_RETENTION_BELOW_STATUTORY to
# "yes-i-have-checked-the-law" as well.
AUDIT_RETENTION_YEARS=7

# Only alongside a retention period shorter than seven years, and only once
# the shorter period has actually been checked against the law that applies.
# Without it, a lower AUDIT_RETENTION_YEARS drops nothing at all.
# AUDIT_RETENTION_BELOW_STATUTORY="yes-i-have-checked-the-law"

# How many months of partitions to keep ahead of today. The API does this at
# startup and on the first of each month; the margin is what covers a month
# boundary passing while nothing happened to be running.
AUDIT_PARTITION_MONTHS_AHEAD=3

# ── App ───────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"

# Sign-in rate limit, applied per account (not per IP, because every staff
# login reaches the API from the web server's single address). Defaults to 10
# attempts per 15 minutes when unset. Raise it for local runs where an
# automated suite signs in repeatedly as one account.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=900000
