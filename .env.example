# ─────────────────────────────────────────────────────────────
# ROOT — shared across all apps. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://hms_user:hms_password@localhost:5432/hms_db?schema=public"
DATABASE_URL_TEST="postgresql://hms_user:hms_password@localhost:5432/hms_test?schema=public"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── API ───────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"   # /api/v1 is appended automatically by api-client
NEXT_PUBLIC_APP_NAME="CareSync HMS"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ── AWS S3 (file storage) ─────────────────────────────────────
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_S3_BUCKET="hms-dev-files"
AWS_S3_ENDPOINT=""           # Leave empty for real AWS; set for localstack

# ── Email ─────────────────────────────────────────────────────
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@caresync.ng"

# ── SMS — Termii ──────────────────────────────────────────────
TERMII_API_KEY=""
TERMII_SENDER_ID="CareSync"

# ── Encryption (PHI field-level) ──────────────────────────────
FIELD_ENCRYPTION_KEY="CHANGE_ME_32_byte_hex_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── App ───────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"

# Sign-in rate limit, applied per account (not per IP, because every staff
# login reaches the API from the web server's single address). Defaults to 10
# attempts per 15 minutes when unset. Raise it for local runs where an
# automated suite signs in repeatedly as one account.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=900000
